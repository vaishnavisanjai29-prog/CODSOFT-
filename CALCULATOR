N1=int(input("enter first number:"))
N2=int(input("enter second number:))
operation=input("enter operation(+,-,*,/):")
if operation=="+":
    print("result=",N1+N2)
elif operation=="-":
    print("result=",N1-N2)
elif operation=="*":
    print("result=",N1*N2)
elif operation=="/":
    print("result=",N1/N2)
else:
    print("invalid operation")
